{
  "manifest_version": 3,
  "name": "Recap Demo",
  "version": "1.0.0",
  "description": "Panneau lateral pour garder sous les yeux un pense-bete riche pendant vos demos.",
  "permissions": ["storage", "sidePanel"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Recap Demo"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
